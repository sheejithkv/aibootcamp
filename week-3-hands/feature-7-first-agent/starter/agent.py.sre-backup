"""
Feature 7: First Agent

Two-call tool-calling loop:

User
  -> LLM with tool schemas
  -> execute requested tools
  -> append tool results
  -> LLM synthesis
  -> final answer
"""

import inspect
import json
from typing import Any

from shared.llm_client import call_llm
from shared.session_store import add_message, get_session
from shared.tools import (
    CHECK_AVAILABILITY_SCHEMA,
    CREATE_TICKET_SCHEMA,
    LOOKUP_INFO_SCHEMA,
    check_availability,
    create_ticket,
    lookup_info,
)


TOOLS_REGISTRY: dict[str, tuple[Any, dict]] = {
    "check_availability": (
        check_availability,
        CHECK_AVAILABILITY_SCHEMA,
    ),
    "create_ticket": (
        create_ticket,
        CREATE_TICKET_SCHEMA,
    ),
    "lookup_info": (
        lookup_info,
        LOOKUP_INFO_SCHEMA,
    ),
}

_TOOL_SCHEMAS = [
    schema
    for _, schema in TOOLS_REGISTRY.values()
]


_AGENT_SYSTEM_PROMPT = """
You are a helpful AI assistant.

You have access to tools that can:
- check availability
- create support tickets
- look up factual information

Use a tool when the user's request requires information or an action
provided by that tool.

Do not invent tool results.

When a tool is used, wait for the tool result and then provide a clear
natural-language response.

If no tool is required, answer directly.
""".strip()


async def run_agent(
    message: str,
    session_id: str,
    tenant_id: str = "default",
) -> dict:
    """
    Run one turn of the Feature 7 agent.

    Returns:
        {
            "result": str,
            "steps": [
                {
                    "tool": str,
                    "args": dict,
                    "result": dict
                }
            ],
            "tools_used": [str]
        }
    """

    # ------------------------------------------------------------------
    # Build conversation context
    # ------------------------------------------------------------------

    session = get_session(
        session_id,
        tenant_id=tenant_id,
    )

    history: list[dict] = []

    if session:
        for msg in session.messages[-20:]:
            history.append(
                {
                    "role": msg.role,
                    "content": msg.content,
                }
            )

    messages: list[dict] = [
        {
            "role": "system",
            "content": _AGENT_SYSTEM_PROMPT,
        },
        *history,
        {
            "role": "user",
            "content": message,
        },
    ]

    # ------------------------------------------------------------------
    # STEP 1
    # First LLM call: allow the model to select tools.
    # ------------------------------------------------------------------

    first_response = await call_llm(
        messages=messages,
        tools=_TOOL_SCHEMAS,
        temperature=0.3,
        max_tokens=1000,
    )

    steps: list[dict] = []
    tools_used: list[str] = []

    tool_calls = first_response.tool_calls or []

    # ------------------------------------------------------------------
    # STEP 2
    # No tool call -> first response is already the answer.
    # ------------------------------------------------------------------

    if not tool_calls:
        answer = first_response.content or ""

        add_message(
            session_id,
            "user",
            message,
        )

        add_message(
            session_id,
            "assistant",
            answer,
        )

        return {
            "result": answer,
            "steps": [],
            "tools_used": [],
        }

    # ------------------------------------------------------------------
    # STEP 3
    # Preserve the assistant tool-call decision in message history.
    # ------------------------------------------------------------------

    assistant_tool_calls = []

    for tc in tool_calls:
        tool_call_message = {
            "id": tc["id"],
            "type": "function",
            "function": {
                "name": tc["name"],
                "arguments": json.dumps(
                    tc.get("arguments", {})
                ),
            },
        }

        # Gemini thinking models attach a thought_signature here.
        # It must be passed back unchanged on the next LLM request.
        if tc.get("extra_content"):
            tool_call_message["extra_content"] = tc["extra_content"]

        assistant_tool_calls.append(tool_call_message)

    messages.append(
        {
            "role": "assistant",
            "content": first_response.content,
            "tool_calls": assistant_tool_calls,
        }
    )

    # Execute every tool requested by the model.
    for tc in tool_calls:
        tool_name = tc["name"]

        args = tc.get(
            "arguments",
            {},
        )

        # Be tolerant if a provider returns JSON arguments as a string.
        if isinstance(args, str):
            try:
                args = json.loads(args)
            except json.JSONDecodeError:
                args = {}

        fn, _ = TOOLS_REGISTRY.get(
            tool_name,
            (None, None),
        )

        if fn is None:
            tool_result = {
                "error": f"Unknown tool '{tool_name}'"
            }

        else:
            try:
                value = fn(**args)

                # Supports both async and normal Python tools.
                if inspect.isawaitable(value):
                    value = await value

                tool_result = value

            except Exception as exc:
                tool_result = {
                    "error": str(exc)
                }

        steps.append(
            {
                "tool": tool_name,
                "args": args,
                "result": tool_result,
            }
        )

        tools_used.append(tool_name)

        # Give the result back to the LLM.
        messages.append(
            {
                "role": "tool",
                "tool_call_id": tc["id"],
                "content": json.dumps(
                    tool_result,
                    default=str,
                ),
            }
        )

    # ------------------------------------------------------------------
    # STEP 4
    # Second LLM call: synthesize the tool results into a user answer.
    # ------------------------------------------------------------------

    second_response = await call_llm(
        messages=messages,
        temperature=0.7,
        max_tokens=1000,
    )

    answer = second_response.content or ""

    add_message(
        session_id,
        "user",
        message,
    )

    add_message(
        session_id,
        "assistant",
        answer,
    )

    return {
        "result": answer,
        "steps": steps,
        "tools_used": list(
            dict.fromkeys(tools_used)
        ),
    }
